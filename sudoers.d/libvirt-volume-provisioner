# sudoers rules for libvirt-volume-provisioner
# Allows the service user to run privileged LVM and block-device commands
# without a password. The -n flag in sudo ensures these are non-interactive.
libvirt-volume-provisioner ALL=(root) NOPASSWD: \
    /usr/sbin/vgs, \
    /usr/sbin/lvcreate, \
    /usr/sbin/lvremove, \
    /usr/sbin/lvs, \
    /usr/sbin/blkid, \
    /usr/bin/qemu-img, \
    /usr/bin/dd, \
    /usr/bin/test

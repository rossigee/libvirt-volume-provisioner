[Unit]
Description=Libvirt Volume Provisioner
After=network.target libvirtd.service
Requires=libvirtd.service
Wants=network-online.target

[Service]
Type=simple
User=libvirt-volume-provisioner
Group=libvirt-qemu
# Credentials only — all other settings live in /etc/libvirt-volume-provisioner/config.yaml
EnvironmentFile=-/etc/default/libvirt-volume-provisioner
ExecStart=/usr/bin/libvirt-volume-provisioner --config /etc/libvirt-volume-provisioner/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/libvirt,/var/lib/libvirt-volume-provisioner,/var/lib/libvirt/images,/var/log/libvirt-volume-provisioner,/etc/libvirt-volume-provisioner,/tmp,/run/lock/lvm
RestrictSUIDSGID=true
PrivateDevices=no
DeviceAllow=/dev/mapper/* rwm
DeviceAllow=/dev/dm-* rwm

# Resource limits
#
# 512M was not enough. On itx-002 the daemon ran for 12h45m and was deactivated
# with "513M memory peak"; the restart emptied its in-memory job registry, and
# every in-flight job then reported "not found" to the operator. Peak usage
# comes from concurrent qcow2 imports, and a single restart used to stall
# volume creation for an operator's whole retry budget (an hour). Hosts have
# ~89GiB of RAM, so 2G still bounds a runaway import.
MemoryMax=2G
MemoryHigh=1536M
LimitNOFILE=65536
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target